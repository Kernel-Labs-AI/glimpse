{
  "name": "@kernel-labs/glimpse",
  "version": "0.2.1",
  "description": "Upload Playwright screenshots to Supabase, S3, or Vercel Blob and post GitHub PR comments",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "glimpse": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./playwright": {
      "import": "./dist/playwright/index.js",
      "types": "./dist/playwright/index.d.ts"
    },
    "./test": {
      "import": "./dist/playwright/fixture.js",
      "types": "./dist/playwright/fixture.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "test": "playwright test"
  },
  "keywords": [
    "playwright",
    "screenshots",
    "github",
    "pr",
    "pull-request",
    "visual-testing",
    "supabase",
    "s3",
    "vercel",
    "vercel-blob"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kernel-Labs-AI/glimpse.git"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@supabase/supabase-js": "^2.79.0",
    "@vercel/blob": "^2.4.0",
    "commander": "^12.1.0",
    "odiff-bin": "^4.3.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "@playwright/test": "^1.40.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  }
}
